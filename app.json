{
  "expo": {
    "name": "DiscoverAustralia",
    "slug": "discover-australia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/favicon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#111418"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111418"
      },
      "package": "com.discover.australia",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.discover.australia",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "ff104961-2647-4a83-9eb3-6b903041d9cc"
      }
    }
  }
}
